@* O menu vertical. Aparece em todas as páginas porque o MainLayout o inclui. *@

<div class="top-row ps-3">
    <div class="container-fluid">
        @* O nome da aplicação vem da classe AppConfig (Etapa 1, alínea 3.h). *@
        <a class="logo-span" href="">@AppConfig.tituloHomePage</a>
    </div>
</div>

<input type="checkbox" title="Menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Gestão de Hotéis
            </NavLink>
        </div>

        @* As sete listagens. Cada href é o @page de uma página Index gerada pelo scaffolder.
           Ficam visíveis a todos (como no menu da aula), mas as páginas têm [Authorize]:
           quem não tiver o role certo não entra, mesmo vendo a ligação. *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="hoteis">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Unidades hoteleiras
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="alojamentos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Alojamentos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="categorias">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Categorias
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="caracteristicas">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Características
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="regimes">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Regimes alimentares
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="modos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Disponibilização
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="campanhas">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Campanhas
            </NavLink>
        </div>

        @* AuthorizeView COM Roles: só o Administrador e o Funcionario veem esta entrada.
           A página das reservas ainda não existe: é feita numa etapa mais à frente. *@
        <AuthorizeView Roles="Administrador,Funcionario">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="gerereservas">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Gerir Reservas
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

<div class="bottom-row">
    <nav class="flex-column">
        @* AuthorizeView COM Roles: só o Administrador gere utilizadores e roles.
           Estas duas páginas também ainda não existem. *@
        <AuthorizeView Roles="Administrador">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Account/GereUser">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Gerir Utilizadores
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Account/GereRoles">
                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Gerir Roles
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>