@* O menu vertical. Aparece em todas as páginas porque o MainLayout o inclui. *@

<div class="top-row ps-3">
    <div class="container-fluid">
        @* O nome da aplicação vem da classe AppConfig (Etapa 1, alínea 3.h). *@
        <a class="logo-span" href="">@AppConfig.tituloHomePage</a>
    </div>
</div>

<input type="checkbox" title="Menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Gestão de Hotéis
            </NavLink>
        </div>

        @* AuthorizeView COM Roles: só o Administrador e o Funcionario veem estas entradas.
           São os mesmos roles do [Authorize] das páginas: quem não pode abrir uma página
           também não vê a ligação para ela. Esconder (aqui) e proteger (o [Authorize] de
           cada página) andam juntos: sem sessão, ou só com o role Cliente, o menu fica
           apenas com "Gestão de Hotéis". *@
        <AuthorizeView Roles="Administrador,Funcionario">
            @* As entradas estão arrumadas em secções, cada uma com um título (.nav-section).
               Cada href é o @page de uma página Index. *@

            @* Oferta: o que a empresa tem para reservar. *@
            <div class="nav-section">Oferta</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="hoteis">
                    <span class="bi bi-unidades-hoteleiras-nav-menu" aria-hidden="true"></span> Unidades hoteleiras
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="alojamentos">
                    <span class="bi bi-alojamentos-nav-menu" aria-hidden="true"></span> Alojamentos
                </NavLink>
            </div>

            @* Classificação: as listas que descrevem cada alojamento. *@
            <div class="nav-section">Classificação</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="categorias">
                    <span class="bi bi-categorias-nav-menu" aria-hidden="true"></span> Categorias
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="caracteristicas">
                    <span class="bi bi-caracteristicas-nav-menu" aria-hidden="true"></span> Características
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="regimes">
                    <span class="bi bi-regimes-alimentares-nav-menu" aria-hidden="true"></span> Regimes alimentares
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="modos">
                    <span class="bi bi-disponibilizacao-nav-menu" aria-hidden="true"></span> Disponibilização
                </NavLink>
            </div>

            @* Comercial: os preços por período e as reservas dos clientes. *@
            <div class="nav-section">Comercial</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="campanhas">
                    <span class="bi bi-campanhas-nav-menu" aria-hidden="true"></span> Campanhas
                </NavLink>
            </div>

            @* A página das reservas ainda não existe: é feita numa etapa mais à frente. *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="gerereservas">
                    <span class="bi bi-gerir-reservas-nav-menu" aria-hidden="true"></span> Gerir Reservas
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

<div class="bottom-row">
    <nav class="flex-column">
        @* AuthorizeView COM Roles: só o Administrador gere utilizadores e roles.
           Estas duas páginas também ainda não existem. O título fica dentro do
           AuthorizeView: o funcionário não vê uma secção vazia. *@
        <AuthorizeView Roles="Administrador">
            <div class="nav-section">Administração</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Account/GereUser">
                    <span class="bi bi-gerir-utilizadores-nav-menu" aria-hidden="true"></span> Gerir Utilizadores
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Account/GereRoles">
                    <span class="bi bi-gerir-roles-nav-menu" aria-hidden="true"></span> Gerir Roles
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>
