@page "/hotels/delete"
@using Microsoft.EntityFrameworkCore
@using GestaoHoteis.Entities
@inject IDbContextFactory<GestaoHoteis.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Hotel</h2>
    <hr />
    @if (hotel is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nome</dt>
            <dd class="col-sm-10">@hotel.Nome</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Tipo</dt>
            <dd class="col-sm-10">@hotel.Tipo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Estrelas</dt>
            <dd class="col-sm-10">@hotel.Estrelas</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Descricao</dt>
            <dd class="col-sm-10">@hotel.Descricao</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UrlImagem</dt>
            <dd class="col-sm-10">@hotel.UrlImagem</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Imagem</dt>
            <dd class="col-sm-10">@hotel.Imagem</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Ativo</dt>
            <dd class="col-sm-10">@hotel.Ativo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">MoradaId</dt>
            <dd class="col-sm-10">@hotel.MoradaId</dd>
        </dl>
        <EditForm method="post" Model="hotel" OnValidSubmit="DeleteHotel" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(hotel is null)">Delete</button> |
            <a href="/hotels">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Hotel? hotel;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        hotel = await context.Hoteis.FirstOrDefaultAsync(m => m.Id == Id);

        if (hotel is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteHotel()
    {
        using var context = DbFactory.CreateDbContext();
        context.Hoteis.Remove(hotel!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/hotels");
    }
}
