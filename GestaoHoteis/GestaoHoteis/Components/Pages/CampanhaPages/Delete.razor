@page "/campanhas/delete"
@using Microsoft.EntityFrameworkCore
@using GestaoHoteis.Entities
@inject IDbContextFactory<GestaoHoteis.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Campanha</h2>
    <hr />
    @if (campanha is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nome</dt>
            <dd class="col-sm-10">@campanha.Nome</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Descricao</dt>
            <dd class="col-sm-10">@campanha.Descricao</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Percentagem</dt>
            <dd class="col-sm-10">@campanha.Percentagem</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DataInicio</dt>
            <dd class="col-sm-10">@campanha.DataInicio</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DataFim</dt>
            <dd class="col-sm-10">@campanha.DataFim</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Ativo</dt>
            <dd class="col-sm-10">@campanha.Ativo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">HotelId</dt>
            <dd class="col-sm-10">@campanha.HotelId</dd>
        </dl>
        <EditForm method="post" Model="campanha" OnValidSubmit="DeleteCampanha" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(campanha is null)">Delete</button> |
            <a href="/campanhas">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Campanha? campanha;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        campanha = await context.Campanhas.FirstOrDefaultAsync(m => m.Id == Id);

        if (campanha is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteCampanha()
    {
        using var context = DbFactory.CreateDbContext();
        context.Campanhas.Remove(campanha!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/campanhas");
    }
}
