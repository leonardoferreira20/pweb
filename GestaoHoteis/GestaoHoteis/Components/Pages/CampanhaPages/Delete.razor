@page "/campanhas/delete"
@* Do framework: o [Authorize] e o EF Core (IDbContextFactory, Include, ...) *@
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@* Nosso: as entidades (já estão no _Imports.razor; o scaffolding repete-as) *@
@using GestaoHoteis.Entities
@* Quem pode abrir: Administrador ou Funcionario (apagar; quadro de permissões, secção 3.0) *@
@attribute [Authorize(Roles = "Administrador,Funcionario")]
@* Serviços do framework, pedidos ao contentor de injeção de dependências *@
@inject IDbContextFactory<GestaoHoteis.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@* Serviços nossos, pedidos pela interface (pasta Interfaces) *@
@inject IMensagensService Mensagens

<PageTitle>Apagar</PageTitle>

<h1>Apagar registo</h1>

<h3>Tem a certeza de que quer apagar este registo?</h3>
<div>
    <h4>Campanha</h4>
    <hr />
    @if (campanha is null)
    {
        <p><em>A carregar...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Nome</dt>
            <dd class="col-sm-10">@campanha.Nome</dd>
            <dt class="col-sm-2">Descrição</dt>
            <dd class="col-sm-10">@campanha.Descricao</dd>
            <dt class="col-sm-2">Unidade</dt>
            <dd class="col-sm-10">@campanha.hotel.Nome</dd>
            <dt class="col-sm-2">Ajuste do preço</dt>
            <dd class="col-sm-10">@campanha.Percentagem.ToString("+0.00;-0.00") % (@(campanha.Percentagem > 0 ? "aumento" : "desconto"))</dd>
            <dt class="col-sm-2">Período</dt>
            <dd class="col-sm-10">@campanha.DataInicio.ToString("dd/MM/yyyy") a @campanha.DataFim.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-2">Ativa</dt>
            <dd class="col-sm-10">@(campanha.Ativo ? "Sim" : "Não")</dd>
        </dl>

        @* Nada depende de uma campanha: as reservas guardam o valor já calculado (RN75),
           por isso apagar uma campanha não altera reservas existentes. *@
        <EditForm method="post" Model="campanha" OnValidSubmit="DeleteCampanha" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" title="Apagar">
                <img src="/img/deleteicon.png" style="height:30px" alt="Apagar" />
            </button> |
            <a href="/campanhas" class="btn btn-outline-secondary" title="Voltar à listagem">
                <img src="/img/backicon.png" style="height:30px" alt="Voltar" />
            </a>
        </EditForm>
    }
</div>

@code {
    private Campanha? campanha;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // Include: sem ele, campanha.hotel vinha a null.
        campanha = await context.Campanhas
            .Include(c => c.hotel)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (campanha is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // Delete: Remove marca o objeto para apagar; SaveChangesAsync faz o DELETE.
    private async Task DeleteCampanha()
    {
        using var context = DbFactory.CreateDbContext();
        context.Campanhas.Remove(campanha!);
        await context.SaveChangesAsync();
        Mensagens.Sucesso("Campanha apagada.");
        NavigationManager.NavigateTo("/campanhas");
    }
}
