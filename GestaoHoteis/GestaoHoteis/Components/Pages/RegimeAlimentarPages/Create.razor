@page "/regimealimentars/create"
@using Microsoft.EntityFrameworkCore
@using GestaoHoteis.Entities
@inject IDbContextFactory<GestaoHoteis.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>RegimeAlimentar</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="RegimeAlimentar" OnValidSubmit="AddRegimeAlimentar" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="nome" class="form-label">Nome:</label> 
                <InputText id="nome" @bind-Value="RegimeAlimentar.Nome" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => RegimeAlimentar.Nome" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="descricao" class="form-label">Descricao:</label> 
                <InputText id="descricao" @bind-Value="RegimeAlimentar.Descricao" class="form-control" /> 
                <ValidationMessage For="() => RegimeAlimentar.Descricao" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="percentagem" class="form-label">Percentagem:</label> 
                <InputNumber id="percentagem" @bind-Value="RegimeAlimentar.Percentagem" class="form-control" /> 
                <ValidationMessage For="() => RegimeAlimentar.Percentagem" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="ativo" class="form-label">Ativo:</label> 
                <InputCheckbox id="ativo" @bind-Value="RegimeAlimentar.Ativo" class="form-check-input" /> 
                <ValidationMessage For="() => RegimeAlimentar.Ativo" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/regimealimentars">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private RegimeAlimentar RegimeAlimentar { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddRegimeAlimentar()
    {
        using var context = DbFactory.CreateDbContext();
        context.RegimesAlimentares.Add(RegimeAlimentar);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/regimealimentars");
    }
}
